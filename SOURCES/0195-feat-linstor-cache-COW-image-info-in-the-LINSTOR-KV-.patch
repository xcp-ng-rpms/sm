@@ -470,6 +534,34 @@ class LinstorCowUtil:
     # Helpers.
     # --------------------------------------------------------------------------
 
+    @contextlib.contextmanager
+    def _updating_image_info(self, path, props=('hidden', 'size_virt', 'parent_uuid'), **values):
+        """
+        Keep the image info cached in the KV store in sync with an image
+        modification: `props` are invalidated before, `values` are written
+        after, only if the modification succeeded.
+        A crash in between leaves invalid entries, so the next `get_info`
+        reads the image.
+        """
+
+        vdi_uuid = self._extract_uuid(path)
+        self._linstor.invalidate_volume_image_info(
+            vdi_uuid,
+            hidden='hidden' in props,
+            size_virt='size_virt' in props,
+            parent_uuid='parent_uuid' in props
+        )
+
+        yield
+
+        if not values:
+            return
+        try:
+            self._linstor.set_volume_image_info(vdi_uuid, **values)
+        except Exception as e:
+            # Not fatal: entries are still invalid.
+            util.SMlog(f'Failed to update image info of {vdi_uuid} in KV store: {e}')
+
