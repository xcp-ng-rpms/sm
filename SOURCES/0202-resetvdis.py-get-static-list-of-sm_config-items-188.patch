From 8724dc39441190fc249c8a97c505450d198a0c33 Mon Sep 17 00:00:00 2001
From: Anthoine <anthoine.bourgeois@vates.tech>
Date: Mon, 9 Nov 2026 15:47:17 +0100
Subject: [PATCH] resetvdis.py: get static list of sm_config items (#188)

.items() function create a live view of the dict. If the dict gains or
loses keys while you're looping over it, Python raises that RuntimeError
on the next iteration. list() takes a copy up front, so the loop doesn't
care what clean_vdi_status() removes.

Signed-off-by: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
---
 drivers/resetvdis.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/resetvdis.py b/drivers/resetvdis.py
index b8764466..5132a79a 100755
--- a/drivers/resetvdis.py
+++ b/drivers/resetvdis.py
@@ -77,7 +77,7 @@ def reset_vdi(session, vdi_uuid, force, term_output=True, writable=True):
     sm_config = vdi_rec["sm_config"]
     host_ref = None
     clean = True
-    for key, val in sm_config.items():
+    for key, val in list(sm_config.items()):
         if key.startswith("host_"):
             host_ref = key[len("host_"):]
             host_uuid = None
