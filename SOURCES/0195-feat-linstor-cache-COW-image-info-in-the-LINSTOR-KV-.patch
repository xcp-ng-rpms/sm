+class TestLinstorCowUtilImageInfo(unittest.TestCase):
+    @override
+    def setUp(self):
+        self.manager = make_manager([VDI_UUID, PARENT_UUID])
+        # The image itself is never accessed: all cowutil calls are mocked.
+        with mock.patch('linstorcowutil.getCowUtil', return_value=mock.MagicMock()):
+            self.linstorcowutil = LinstorCowUtil(None, self.manager, VdiType.VHD)
+        self.cowutil = self.linstorcowutil.cowutil
+        self.path = device_path(VDI_UUID)
+        self.parent_path = device_path(PARENT_UUID)
+
+        log_patcher = mock.patch('linstorcowutil.util.SMlog', autospec=True)
+        self.mock_log = log_patcher.start()
+        self.addCleanup(log_patcher.stop)
+
+    def store(self, hidden=False, size_virt=1024, parent_uuid=PARENT_UUID):
+        self.manager.set_volume_image_info(VDI_UUID, hidden=hidden, size_virt=size_virt, parent_uuid=parent_uuid)
+
+    def image_info(self, size_virt=4096, hidden=True, parent=True):
+        info = CowImageInfo(VDI_UUID)
+        info.path = self.path
+        info.sizeVirt = size_virt
+        info.sizePhys = 8192
+        info.hidden = hidden
+        if parent:
+            info.parentUuid = PARENT_UUID
+            info.parentPath = self.parent_path
+        return info
+
+    def assert_image_info(self, hidden, size_virt, parent_uuid):
+        self.assertEqual(
+            self.manager.get_volume_image_info(VDI_UUID),
+            {'hidden': hidden, 'size_virt': size_virt, 'parent_uuid': parent_uuid}
+        )
+
+    def assert_all_invalid(self):
+        for prop in LinstorVolumeManager.IMAGE_INFO_PROPS:
+            self.assertEqual(get_prop(self.manager, VDI_UUID, prop), INVALID)
+
+    # --------------------------------------------------------------------------
+    # get_info.
+    # --------------------------------------------------------------------------
+
+    def test_get_info_hit(self):
+        self.store(hidden=True)
+
+        with mock.patch.object(self.cowutil, 'getInfo') as get_info:
+            info = self.linstorcowutil.get_info(VDI_UUID)
+
+        get_info.assert_not_called()
+        self.assertEqual(info.uuid, VDI_UUID)
+        self.assertEqual(info.path, self.path)
+        self.assertEqual(info.sizeVirt, 1024)
+        self.assertEqual(info.sizePhys, -1)
+        self.assertEqual(info.sizeAllocated, -1)
+        self.assertTrue(info.hidden)
+        self.assertEqual(info.parentUuid, PARENT_UUID)
+        self.assertEqual(info.parentPath, self.parent_path)
+
+    def test_get_info_hit_no_parent(self):
+        self.store(parent_uuid='')
+
+        with mock.patch.object(self.cowutil, 'getInfo') as get_info:
+            info = self.linstorcowutil.get_info(VDI_UUID)
+
+        get_info.assert_not_called()
+        self.assertEqual(info.parentUuid, '')
+        self.assertEqual(info.parentPath, '')
+
+    def test_get_info_hit_without_include_parent(self):
+        self.store()
+
+        with mock.patch.object(self.cowutil, 'getInfo') as get_info:
+            info = self.linstorcowutil.get_info(VDI_UUID, include_parent=False)
+
+        get_info.assert_not_called()
+        self.assertEqual(info.parentUuid, '')
+
+    def test_get_info_miss_stores_info(self):
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info()) as get_info:
+            info = self.linstorcowutil.get_info(VDI_UUID)
+
+        get_info.assert_called_once()
+        self.assertEqual(info.sizePhys, 8192)
+        self.assert_image_info(True, 4096, PARENT_UUID)
+
+    def test_get_info_miss_no_parent(self):
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info(parent=False)):
+            self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assert_image_info(True, 4096, '')
+
+    def test_get_info_invalid_reads_image(self):
+        self.store()
+        self.manager.invalidate_volume_image_info(VDI_UUID, hidden=False, parent_uuid=False)
+
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info()) as get_info:
+            self.linstorcowutil.get_info(VDI_UUID)
+
+        get_info.assert_called_once()
+        self.assert_image_info(True, 4096, PARENT_UUID)
+
+    def test_get_info_miss_without_include_parent_not_stored(self):
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info(parent=False)):
+            self.linstorcowutil.get_info(VDI_UUID, include_parent=False)
+
+        self.assertIsNone(self.manager.get_volume_image_info(VDI_UUID))
+
+    def test_get_info_miss_bad_size_not_stored(self):
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info(size_virt=-1)):
+            self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assertIsNone(self.manager.get_volume_image_info(VDI_UUID))
+
+    def test_get_info_store_failure_is_not_fatal(self):
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info()), \
+                mock.patch.object(LinstorVolumeManager, 'set_volume_image_info', side_effect=Exception('KV down')):
+            info = self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assertEqual(info.sizeVirt, 4096)
+        self.mock_log.assert_called_once()
+
+    def test_get_info_read_failure(self):
+        with mock.patch.object(self.cowutil, 'getInfo', side_effect=Exception('read error')):
+            with self.assertRaises(Exception):
+                self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assertIsNone(self.manager.get_volume_image_info(VDI_UUID))
+
+    # --------------------------------------------------------------------------
+    # Setters.
+    # --------------------------------------------------------------------------
+
+    def check_invalid_during_call(self, props):
+        def side_effect(*args, **kwargs):
+            for prop in props:
+                self.assertEqual(get_prop(self.manager, VDI_UUID, prop), INVALID)
+            return 0
+        return side_effect
+
+    def test_set_hidden(self):
+        self.store(hidden=False)
+
+        with mock.patch.object(self.cowutil, 'setHidden', side_effect=self.check_invalid_during_call([HIDDEN])) as set_hidden:
+            self.linstorcowutil.set_hidden(self.path, True)
+
+        set_hidden.assert_called_once_with(self.path, True)
+        self.assert_image_info(True, 1024, PARENT_UUID)
+
+    def test_set_hidden_failure_stays_invalid(self):
+        self.store(hidden=False)
+
+        with mock.patch.object(self.cowutil, 'setHidden', side_effect=Exception('write error')):
+            with self.assertRaises(Exception):
+                self.linstorcowutil.set_hidden(self.path, True)
+
+        self.assertEqual(get_prop(self.manager, VDI_UUID, HIDDEN), INVALID)
+        self.assertEqual(get_prop(self.manager, VDI_UUID, SIZE_VIRT), '1024')
+        self.assertIsNone(self.manager.get_volume_image_info(VDI_UUID))
+
+    def test_set_hidden_kv_write_failure_is_not_fatal(self):
+        self.store(hidden=False)
+
+        with mock.patch.object(self.cowutil, 'setHidden'), \
+                mock.patch.object(LinstorVolumeManager, 'set_volume_image_info', side_effect=Exception('KV down')):
+            self.linstorcowutil.set_hidden(self.path, True)
+
+        self.assertEqual(get_prop(self.manager, VDI_UUID, HIDDEN), INVALID)
+        self.mock_log.assert_called_once()
+
+    def test_set_parent(self):
+        self.store(parent_uuid='')
+
+        with mock.patch.object(self.cowutil, 'setParent', side_effect=self.check_invalid_during_call([PARENT])):
+            self.linstorcowutil.set_parent(self.path, self.parent_path, False)
+
+        self.assert_image_info(False, 1024, PARENT_UUID)
+
+    def test_force_parent(self):
+        self.store(parent_uuid='')
+
+        with mock.patch.object(self.cowutil, 'setParent', side_effect=self.check_invalid_during_call([PARENT])):
+            self.linstorcowutil.force_parent(self.path, self.parent_path)
+
+        self.assert_image_info(False, 1024, PARENT_UUID)
+
+    def test_set_size_virt(self):
+        self.store()
+
+        with mock.patch.object(self.cowutil, 'setSizeVirt', side_effect=self.check_invalid_during_call([SIZE_VIRT])):
+            self.linstorcowutil.set_size_virt(self.path, 4096, 'journal')
+
+        self.assertEqual(get_prop(self.manager, VDI_UUID, SIZE_VIRT), INVALID)
+        self.assertEqual(get_prop(self.manager, VDI_UUID, HIDDEN), '0')
+        self.assertEqual(get_prop(self.manager, VDI_UUID, PARENT), PARENT_UUID)
+
+    def test_set_size_virt_fast(self):
+        self.store()
+
+        with mock.patch.object(self.cowutil, 'setSizeVirtFast', side_effect=self.check_invalid_during_call([SIZE_VIRT])):
+            self.linstorcowutil.set_size_virt_fast(self.path, 4096)
