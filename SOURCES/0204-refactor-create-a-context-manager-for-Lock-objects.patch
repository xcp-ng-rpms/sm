From 2c599019ada8055ebeae2a137cde98d6d7b07be4 Mon Sep 17 00:00:00 2001
From: Antoine Bartuccio <antoine.bartuccio@vates.tech>
Date: Fri, 6 Nov 2026 11:37:28 +0100
Subject: [PATCH] refactor: create a context manager for Lock objects

Cleanup try/finally blocks introduced by cbt locks, we create a context
manager on the Lock/LockImplementation objects.
This doesn't refactor further than this and further cleanups might
be needed but this is a nice first step.

Signed-off-by: Antoine Bartuccio <antoine.bartuccio@vates.tech>
---
 drivers/LVMSR.py | 14 ++++----------
 drivers/lock.py  | 14 ++++++++++++++
 2 files changed, 18 insertions(+), 10 deletions(-)

diff --git a/drivers/LVMSR.py b/drivers/LVMSR.py
index dcd54982..ed605d80 100755
--- a/drivers/LVMSR.py
+++ b/drivers/LVMSR.py
@@ -1400,9 +1400,7 @@ class LVMSR(SR.SR):
             inserted.disable_leaf_on_secondary(inserted.uuid)
 
         # Must be done before moving the backup back, which ends the rollback
-        cbt_lock = lock.Lock("cbtlog", entry.dest.uuid)
-        cbt_lock.acquire()
-        try:
+        with lock.Lock("cbtlog", entry.dest.uuid):
             if cbtlog_backup:
                 # _copy doesn't overwrite, drop the log recreated by _revert_cbt
                 if self.lvmCache.checkLV(cbtlog_backup):
@@ -1411,8 +1409,7 @@ class LVMSR(SR.SR):
             else:
                 # dest had no CBT before the revert, any cbtlog comes from it
                 self._remove_lvs(src._get_cbt_logname(entry.dest.uuid))
-        finally:
-            cbt_lock.release()
+
         util.fistpoint.activate("LVM_revert_rollback_after_cbt", self.uuid)
 
         # Once we move the backup to it's old name, the journal can't be run again
@@ -2883,17 +2880,14 @@ class LVMVDI(VDI.VDI):
         self.sr.journaler.create(self.JRN_COPY, tmp_name, "1")
         self.sr.lvmCache.create(tmp_name, self.sr.lvmCache.getSize(src_name), tag)
         # Same lock as _cbt_op, readers like list_changed_blocks don't hold the SR lock
-        cbt_lock = lock.Lock("cbtlog", src_name.split(".")[0])
-        cbt_lock.acquire()
-        try:
+        with lock.Lock("cbtlog", src_name.split(".")[0]):
             activated = self._activate_cbt_log(src_name)
             with open(src, "rb") as fsrc, open(f"{dst}.tmp", "r+b") as fdst:
                 shutil.copyfileobj(fsrc, fdst)
                 os.fsync(fdst.fileno())
             if activated:
                 self._deactivate_cbt_log(src_name)
-        finally:
-            cbt_lock.release()
+
         self.sr.lvmCache.deactivateNoRefcount(tmp_name)
 
         self.sr.lvmCache.rename(tmp_name, dst_name)
diff --git a/drivers/lock.py b/drivers/lock.py
index 390debe3..1a6446bd 100755
--- a/drivers/lock.py
+++ b/drivers/lock.py
@@ -55,6 +55,12 @@ class Lock(object):
             instances[name] = LockImplementation(name, ns)
         return instances[name]
 
+    def __enter__(self):
+        raise NotImplementedError("Lock methods implemented in LockImplementation")
+
+    def __exit__(self, *args, **kwargs):
+        raise NotImplementedError("Lock methods implemented in LockImplementation")
+
     def acquire(self):
         raise NotImplementedError("Lock methods implemented in LockImplementation")
 
@@ -222,6 +228,14 @@ class LockImplementation(object):
     # Actual Locking
     #
 
+    def __enter__(self):
+        """Blocking acquire on enter, release on exit"""
+        self.acquire()
+        return self
+
+    def __exit__(self, *args, **kwargs):
+        self.release()
+
     def acquire(self):
         """Blocking lock aquisition, with warnings. We don't expect to lock a
         lot. If so, not to collide. Coarse log statements should be ok
