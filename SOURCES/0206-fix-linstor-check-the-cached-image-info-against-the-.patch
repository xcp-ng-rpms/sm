     def test_invalidate_all(self):
         self.manager.set_volume_image_info(VDI_UUID, hidden=True, size_virt=1024, parent_uuid=PARENT_UUID)
@@ -285,15 +300,75 @@ class TestLinstorCowUtilImageInfo(unittest.TestCase):
         self.assertEqual(info.sizeVirt, 4096)
         self.assertIsNone(self.manager.get_volume_image_info(VDI_UUID))
 
+    def stale_logs(self):
+        # `call.args` / `call.kwargs` don't exist before Python 3.8: unpack.
+        return [
+            args[0] for args, kwargs in self.mock_log.call_args_list
+            if kwargs.get('priority') == util.LOG_ERR
+        ]
+
     def test_get_info_hit_stale_parent_reads_image(self):
-        self.store(parent_uuid=NEW_UUID)
+        # Only the parent is stale: it no longer exists.
+        self.store(hidden=True, size_virt=4096, parent_uuid=NEW_UUID)
 
         with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info()) as get_info:
             info = self.linstorcowutil.get_info(VDI_UUID)
 
         get_info.assert_called_once()
         self.assertEqual(info.parentUuid, PARENT_UUID)
-        self.mock_log.assert_called_once()
+        self.assertEqual(self.mock_log.call_count, 2)
+        stale = self.stale_logs()
+        self.assertEqual(len(stale), 1)
+        self.assertIn('parent_uuid', stale[0])
+
+    def test_get_info_partial_miss_matching_fields(self):
+        self.store(hidden=True, size_virt=1024)
+        self.manager.invalidate_volume_image_info(VDI_UUID, hidden=False, parent_uuid=False)
+
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info()) as get_info:
+            info = self.linstorcowutil.get_info(VDI_UUID)
+
+        get_info.assert_called_once()
+        self.assertEqual(info.sizeVirt, 4096)  # The invalid field isn't compared.
+        self.assertEqual(self.stale_logs(), [])
+
+    def test_get_info_partial_miss_stale_field_is_logged(self):
+        self.store(hidden=False, size_virt=4096)
+        self.manager.invalidate_volume_image_info(VDI_UUID, hidden=False, parent_uuid=False, size_virt=True)
+
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info(hidden=True)):
+            info = self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assertTrue(info.hidden)  # The image value is used.
+        stale = self.stale_logs()
+        self.assertEqual(len(stale), 1)
+        self.assertIn('hidden is False in the cache, True in the image', stale[0])
+
+    def test_get_info_without_parent_doesnt_compare_parent(self):
+        self.store(hidden=True, parent_uuid=NEW_UUID)
+        self.manager.invalidate_volume_image_info(VDI_UUID, hidden=False, parent_uuid=False)
+
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info(parent=False)):
+            self.linstorcowutil.get_info(VDI_UUID, include_parent=False)
+
+        self.assertEqual(self.stale_logs(), [])
+
+    def test_get_info_nothing_cached_nothing_compared(self):
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info()):
+            self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assertEqual(self.stale_logs(), [])
+
+    def test_get_info_scan_error_not_compared(self):
+        self.store(hidden=False)
+        self.manager.invalidate_volume_image_info(VDI_UUID, hidden=False, parent_uuid=False)
+        info = self.image_info(hidden=True)
+        info.error = 'scan-error=1'
+
+        with mock.patch.object(self.cowutil, 'getInfo', return_value=info):
+            self.linstorcowutil.get_info(VDI_UUID)
+
+        self.assertEqual(self.stale_logs(), [])
 
     def test_get_info_miss_without_include_parent_not_stored(self):
         with mock.patch.object(self.cowutil, 'getInfo', return_value=self.image_info(parent=False)):
