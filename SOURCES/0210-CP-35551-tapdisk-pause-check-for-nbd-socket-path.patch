From 648ac86d8436f892c13897ae668d0f0f7727a632 Mon Sep 17 00:00:00 2001
From: Mark Syms <mark.syms@cloud.com>
Date: Mon, 6 Jan 2025 10:26:02 +0000
Subject: [PATCH] CP-35551: tapdisk-pause check for nbd socket path

Signed-off-by: Mark Syms <mark.syms@cloud.com>
---
 drivers/tapdisk-pause       | 17 ++++-------------
 tests/test_tapdisk_pause.py |  6 +-----
 2 files changed, 5 insertions(+), 18 deletions(-)

diff --git a/drivers/tapdisk-pause b/drivers/tapdisk-pause
index fd5b60a2..63a2ead1 100755
--- a/drivers/tapdisk-pause
+++ b/drivers/tapdisk-pause
@@ -40,6 +40,7 @@ except ImportError:
     LINSTOR_AVAILABLE = False
 
 TAPDEV_BACKPATH_PFX = "/dev/sm/backend"
+NBD_BACKPATH_PFX = "/run/blktap-control/nbd/"
 TAPDEV_PHYPATH_PFX = "/dev/sm/phy"
 
 
@@ -74,10 +75,6 @@ def locking(excType, override=True):
         return wrapper
     return locking2
 
-def _getDevMajor_minor(dev):
-    st = os.stat(dev)
-    return [os.major(st.st_rdev),os.minor(st.st_rdev)]
-
 def _mkphylink(sr_uuid, vdi_uuid, path):
     sympath = "/dev/sm/phy/%s/%s" % (sr_uuid,vdi_uuid)
     cmd = ['ln', '-sf', path, sympath]
@@ -109,7 +106,7 @@ class Tapdisk:
         else:
             self.failfast = False
         self.session = session
-        self.path = os.path.join(TAPDEV_BACKPATH_PFX,self.sr_uuid,self.vdi_uuid)
+        self.path = os.path.join(NBD_BACKPATH_PFX,self.sr_uuid,self.vdi_uuid)
         self.phypath = os.path.join(TAPDEV_PHYPATH_PFX,self.sr_uuid,self.vdi_uuid)
         self.lock = Lock("vdi", self.vdi_uuid)
         self.realpath = None
@@ -205,10 +202,7 @@ class Tapdisk:
         if not os.path.exists(self.path):
             util.SMlog("No %s: nothing to pause" % self.path)
             return str(True)
-        self.major, self.minor = _getDevMajor_minor(self.path)
-        if self.major != blktap2.Tapdisk.major():
-            util.SMlog("Non-tap major number: %d" % self.major)
-            return str(False)
+        self.minor = blktap2.VDI.NBDLink(self.path).read_minor_from_path()
         util.SMlog("Calling tap pause with minor %d" % self.minor)
         tapdisk = blktap2.Tapdisk.from_minor(self.minor)
         if tapdisk.is_paused() and not self._is_snap_paused():
@@ -225,10 +219,7 @@ class Tapdisk:
             util.SMlog("No %s: nothing to unpause" % self.path)
             return str(True)
         self._pathRefresh()
-        self.major, self.minor = _getDevMajor_minor(self.path)
-        if self.major != blktap2.Tapdisk.major():
-            util.SMlog("Non-tap major number: %d" % self.major)
-            return str(False)
+        self.minor = blktap2.VDI.NBDLink(self.path).read_minor_from_path()
 
         vdi = VDI.VDI.from_uuid(self.session, self.vdi_uuid)
 
diff --git a/tests/test_tapdisk_pause.py b/tests/test_tapdisk_pause.py
index 2f4cdb3a..51caf659 100644
--- a/tests/test_tapdisk_pause.py
+++ b/tests/test_tapdisk_pause.py
@@ -21,15 +21,13 @@ class TestTapdiskPause(unittest.TestCase):
         self.mock_tapdisk = mock.create_autospec(blktap2.Tapdisk)
         blktap2_patcher = mock.patch('tapdisk_pause.blktap2')
         self.mock_blktap2 = blktap2_patcher.start()
-        self.mock_blktap2.Tapdisk.major.return_value = 254
         vdi_patcher = mock.patch('tapdisk_pause.VDI')
         self.mock_vdi = vdi_patcher.start()
         self.mock_blktap2.Tapdisk.from_minor.side_effect = lambda x: self.mock_tapdisk
         readlink_patcher = mock.patch('tapdisk_pause.os.readlink')
         self.mock_readlink = readlink_patcher.start()
         self.mock_readlink.side_effect = lambda x: x
-        get_dev_patcher = mock.patch('tapdisk_pause._getDevMajor_minor')
-        self.mock_getdev = get_dev_patcher.start()
+        self.mock_blktap2.VDI.NBDLink.return_value.read_minor_from_path.return_value = 5
         self.addCleanup(mock.patch.stopall)
 
     def test_refresh_success(self):
@@ -41,7 +39,6 @@ class TestTapdiskPause(unittest.TestCase):
             'sr_uuid': sr_uuid
         }
 
-        self.mock_getdev.return_value = (254, 5)
         test_vdi = self.mock_vdi.VDI.from_uuid.return_value
         test_vdi._get_blocktracking_status.return_value = False
         self.mock_tapdisk.is_paused.return_value = False
@@ -66,7 +63,6 @@ class TestTapdiskPause(unittest.TestCase):
             'sr_uuid': sr_uuid
         }
 
-        self.mock_getdev.return_value = (254, 5)
         test_vdi = self.mock_vdi.VDI.from_uuid.return_value
         test_vdi._get_blocktracking_status.return_value = False
         self.mock_tapdisk.is_paused.return_value = True
