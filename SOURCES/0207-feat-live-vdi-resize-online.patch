+
+        if self.resize:
+            # Ask tapback to notify the guests of the new size of the VDI.
+            import xen.lowlevel.xs  # pylint: disable=import-error
+            xs = xen.lowlevel.xs.xs()
+            for domid in xs.ls("", "backend/vbd3") or []:
+                for devid in xs.ls("", "backend/vbd3/%s" % domid) or []:
+                    path = "backend/vbd3/%s/%s" % (domid, devid)
+                    # xs.read() returns bytes
+                    if xs.read("", path + "/params") == self.path.encode():
+                        util.SMlog("Notifying resize of %s" % path)
+                        xs.write("", path + "/resize-device", "1")
         return str(True)
 
 
