From 972956ba14ce9d032e9f55e8c78c802677febd00 Mon Sep 17 00:00:00 2001
From: Alexandre Sollier <github@kuruyia.net>
Date: Fri, 13 Nov 2026 16:26:36 +0100
Subject: [PATCH] fix(linstor): retry `build volumes` on manager instantiation
 (#196)

While building the volume list, the LINSTOR volume manager may fail if
it considers that the SR needs to be repaired. For instance, this
happens when it finds volumes whose UUIDs are still being updated in the
KV store. This may be a normal, transient situation if the volume
manager was indeed being instantiated while e.g. a VDI is being
snapshotted. This can especially be seen when the LINSTOR SR is busy.

This adds a retry mechanism to the volume list building operation in
order to wait for the state of the SR to come back to normal.

This issue was observed during testing of XO backups on LINSTOR with NBD
enabled. Testing this patch showed that a single retry after 100ms is
enough to get past this state. A maximum of 10 retries is implemented
here in case the storage stack is under a big load.

Signed-off-by: Alexandre Sollier <alexandre.sollier@vates.tech>
---
 drivers/linstorvolumemanager.py | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/drivers/linstorvolumemanager.py b/drivers/linstorvolumemanager.py
index 3b9013dc..c5a608fd 100755
--- a/drivers/linstorvolumemanager.py
+++ b/drivers/linstorvolumemanager.py
@@ -265,7 +265,8 @@ class LinstorVolumeManagerError(Exception):
     ERR_VOLUME_NOT_EXISTS = 2,
     ERR_VOLUME_DESTROY = 3,
     ERR_GROUP_NOT_EXISTS = 4,
-    ERR_VOLUME_IN_USE = 5
+    ERR_VOLUME_IN_USE = 5,
+    ERR_REPAIR_REQUIRED = 6,
 
     def __init__(self, message, code=ERR_GENERIC):
         super(LinstorVolumeManagerError, self).__init__(message)
@@ -430,13 +431,34 @@ class LinstorVolumeManager(object):
 
         # To increase performance and limit request count to LINSTOR services,
         # we use caches.
-        self._kv_cache = self._create_kv_cache()
         self._resource_cache = None
         self._resource_cache_dirty = True
         self._volume_info_cache = None
         self._volume_info_cache_dirty = True
         self._resources_info_cache = None
-        self._build_volumes(repair=repair)
+
+        # While building the volume list, an error might be thrown if repairing
+        # the SR is required (e.g. a volume is in in the middle of having its
+        # UUID being updated).
+        # This may only be a transient state, so we can retry multiple times to
+        # see if we reach a healthy state.
+        retry_count = 0
+        while True:
+            try:
+                self._kv_cache = self._create_kv_cache()
+                self._build_volumes(repair=repair)
+
+                break
+            except LinstorVolumeManagerError as e:
+                if e.code != LinstorVolumeManagerError.ERR_REPAIR_REQUIRED or retry_count >= 10:
+                    raise
+
+                retry_count += 1
+                self._logger(
+                    f'Cannot build volume list ({e}). Retry number: {retry_count}'
+                )
+
+            time.sleep(0.1)
 
     @property
     def uri(self) -> str:
@@ -2601,7 +2623,8 @@ class LinstorVolumeManager(object):
         if updating_uuid_volumes and not repair:
             raise LinstorVolumeManagerError(
                 'Cannot build LINSTOR volume list: '
-                'It exists invalid "updating uuid volumes", repair is required'
+                'It exists invalid "updating uuid volumes", repair is required',
+                LinstorVolumeManagerError.ERR_REPAIR_REQUIRED
             )
 
         existing_volumes = self._get_volumes_by_property(
