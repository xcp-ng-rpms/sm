+    def test_same_parent(self):
+        vdi = self.vdi(PARENT_UUID, PARENT_UUID)
+        vdi._checkCachedParentMatchesImage()
+        vdi.linstorcowutil.get_parent.assert_called_once_with(VDI_UUID)
+        vdi.sr._linstor.invalidate_volume_image_info.assert_not_called()
+
+    def test_other_parent_cancels(self):
+        for image_parent in (OTHER_UUID, None, '', 'None'):
+            vdi = self.vdi(image_parent, PARENT_UUID)
+            with self.assertRaises(util.SMException):
+                vdi._checkCachedParentMatchesImage()
+            vdi.sr._linstor.invalidate_volume_image_info.assert_called_once_with(VDI_UUID)
+
+    def test_failed_invalidation_still_cancels(self):
+        vdi = self.vdi(OTHER_UUID, PARENT_UUID)
+        vdi.sr._linstor.invalidate_volume_image_info.side_effect = Exception('KV unreachable')
+        with self.assertRaises(util.SMException):
+            vdi._checkCachedParentMatchesImage()
+
+    def test_no_parent_in_both(self):
+        for image_parent in (None, '', 'None'):
+            vdi = self.vdi(image_parent, None)
