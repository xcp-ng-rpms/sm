From d9721c717f8d47197fb06b203e63ae995d89f33f Mon Sep 17 00:00:00 2001
From: Goulven Riou <goulven.riou@vates.tech>
Date: Wed, 4 Nov 2026 23:42:00 +0100
Subject: [PATCH] refactor: share vdi_revert CBT rollback and cbtlog LV
 creation

Signed-off-by: Goulven Riou <goulven.riou@vates.tech>
Signed-off-by: Antoine Bartuccio <antoine.bartuccio@vates.tech>
---
 drivers/FileSR.py | 14 ++------------
 drivers/LVMSR.py  | 34 ++++++++++++----------------------
 drivers/VDI.py    | 13 +++++++++++++
 3 files changed, 27 insertions(+), 34 deletions(-)

diff --git a/drivers/FileSR.py b/drivers/FileSR.py
index 8a29cd54..4cfc8add 100755
--- a/drivers/FileSR.py
+++ b/drivers/FileSR.py
@@ -27,7 +27,6 @@ from pathlib import Path
 from uuid import uuid4
 
 import blktap2
-import cbtutil
 import cleanup
 import fjournaler
 import lock
@@ -566,20 +565,11 @@ class FileSR(SR.SR):
 
         # Must be done before moving the backup back, which ends the rollback
         cbtlog_backup = entry.dest.cbtlog_backup_path
-        logpath = src._get_cbt_logpath(entry.dest.uuid)
         if cbtlog_backup:
-            if util.ioretry(lambda: util.pathexists(cbtlog_backup)):
-                util.SMlog(f"CBT rollback: restoring cbtlog of {entry.dest.uuid} from {cbtlog_backup}")
-                src._copy(cbtlog_backup, logpath)
-            if src._cbt_log_exists(logpath):
-                parent = src._cbt_op(entry.dest.uuid, cbtutil.get_cbt_parent, logpath)
-                parent_path = src._get_cbt_logpath(parent)
-                if src._cbt_log_exists(parent_path):
-                    util.SMlog(f"CBT rollback: relinking cbtlog of {parent} to its child {entry.dest.uuid}")
-                    src._cbt_op(parent, cbtutil.set_cbt_child, parent_path, entry.dest.uuid)
+            src._rollback_revert_cbt(entry.dest.uuid, cbtlog_backup)
         else:
             # dest had no CBT before the revert, any cbtlog comes from it
-            self._unlink_paths(logpath)
+            self._unlink_paths(src._get_cbt_logpath(entry.dest.uuid))
         util.fistpoint.activate("FileSR_revert_rollback_after_cbt", self.uuid)
 
         # Once we move the backup to it's old name, the journal can't be run again
diff --git a/drivers/LVMSR.py b/drivers/LVMSR.py
index 8ecc564f..dcd54982 100755
--- a/drivers/LVMSR.py
+++ b/drivers/LVMSR.py
@@ -29,7 +29,6 @@ from contextlib import contextmanager
 from xmlrpc.client import DateTime
 
 import blktap2
-import cbtutil
 import cleanup
 import lock
 import lvmcache
@@ -1401,26 +1400,17 @@ class LVMSR(SR.SR):
             inserted.disable_leaf_on_secondary(inserted.uuid)
 
         # Must be done before moving the backup back, which ends the rollback
-        logname = src._get_cbt_logname(entry.dest.uuid)
-        logpath = src._get_cbt_logpath(entry.dest.uuid)
         cbt_lock = lock.Lock("cbtlog", entry.dest.uuid)
         cbt_lock.acquire()
         try:
             if cbtlog_backup:
+                # _copy doesn't overwrite, drop the log recreated by _revert_cbt
                 if self.lvmCache.checkLV(cbtlog_backup):
-                    # _copy doesn't overwrite, drop the log recreated by _revert_cbt
-                    self._remove_lvs(logname)
-                    util.SMlog(f"CBT rollback: restoring cbtlog of {entry.dest.uuid} from {cbtlog_backup}")
-                    src._copy(os.path.join(self.path, cbtlog_backup), logpath)
-                if src._cbt_log_exists(logpath):
-                    parent = src._cbt_op(entry.dest.uuid, cbtutil.get_cbt_parent, logpath)
-                    parent_path = src._get_cbt_logpath(parent)
-                    if src._cbt_log_exists(parent_path):
-                        util.SMlog(f"CBT rollback: relinking cbtlog of {parent} to its child {entry.dest.uuid}")
-                        src._cbt_op(parent, cbtutil.set_cbt_child, parent_path, entry.dest.uuid)
+                    self._remove_lvs(src._get_cbt_logname(entry.dest.uuid))
+                src._rollback_revert_cbt(entry.dest.uuid, os.path.join(self.path, cbtlog_backup))
             else:
                 # dest had no CBT before the revert, any cbtlog comes from it
-                self._remove_lvs(logname)
+                self._remove_lvs(src._get_cbt_logname(entry.dest.uuid))
         finally:
             cbt_lock.release()
         util.fistpoint.activate("LVM_revert_rollback_after_cbt", self.uuid)
@@ -2833,13 +2823,17 @@ class LVMVDI(VDI.VDI):
         # We need virtual_size to compute the size in case of a bigger VDI
         self.sr.ensureCBTSpace(self.size)
 
-    @override
-    def _create_cbt_log(self) -> str:
+    def _create_cbt_lv(self, size: int) -> str:
         logname = self._get_cbt_logname(self.uuid)
-        logsize = max(util.roundup(CBT_BLOCK_SIZE, self.size//CBT_BLOCK_SIZE), self.sr.journaler.LV_SIZE)
+        logsize = max(util.roundup(CBT_BLOCK_SIZE, size//CBT_BLOCK_SIZE), self.sr.journaler.LV_SIZE)
         # We choose 4MiB as the minimum for the log size to maintain the old behavior and compute the correct amount
         # if we need a bigger LV for the CBT (can happen with big QCOW2)
         self.sr.lvmCache.create(logname, logsize, CBTLOG_TAG)
+        return logname
+
+    @override
+    def _create_cbt_log(self) -> str:
+        logname = self._create_cbt_lv(self.size)
         logpath = super(LVMVDI, self)._create_cbt_log()
         self.sr.lvmCache.deactivateNoRefcount(logname)
         return logpath
@@ -2946,11 +2940,7 @@ class LVMVDI(VDI.VDI):
 
     @override
     def _create_cbt_log_with_size(self, size: int) -> str:
-        logname = self._get_cbt_logname(self.uuid)
-        logsize = max(util.roundup(CBT_BLOCK_SIZE, size//CBT_BLOCK_SIZE), self.sr.journaler.LV_SIZE)
-        # We choose 4MiB as the minimum for the log size to maintain the old behavior and compute the correct amount
-        # if we need a bigger LV for the CBT (can happen with big QCOW2)
-        self.sr.lvmCache.create(logname, logsize, CBTLOG_TAG)
+        logname = self._create_cbt_lv(size)
         log_path = super()._create_cbt_log_with_size(size)
         self.sr.lvmCache.deactivateNoRefcount(logname)
         return log_path
diff --git a/drivers/VDI.py b/drivers/VDI.py
index 17fa5573..658944d8 100755
--- a/drivers/VDI.py
+++ b/drivers/VDI.py
@@ -1023,6 +1023,19 @@ class VDI(object):
         dest_ref = dest.session.xenapi.VDI.get_by_uuid(dest.uuid)
         dest.session.xenapi.VDI.set_cbt_enabled(dest_ref, True)
 
+    def _rollback_revert_cbt(self, dest_uuid: str, backup_path: str) -> None:
+        """Restore dest's CBT log saved by _revert_cbt and relink its parent"""
+        logpath = self._get_cbt_logpath(dest_uuid)
+        if self._cbt_log_exists(backup_path):
+            util.SMlog(f"CBT rollback: restoring cbtlog of {dest_uuid} from {backup_path}")
+            self._copy(backup_path, logpath)
+        if self._cbt_log_exists(logpath):
+            parent = self._cbt_op(dest_uuid, cbtutil.get_cbt_parent, logpath)
+            parent_path = self._get_cbt_logpath(parent)
+            if self._cbt_log_exists(parent_path):
+                util.SMlog(f"CBT rollback: relinking cbtlog of {parent} to its child {dest_uuid}")
+                self._cbt_op(parent, cbtutil.set_cbt_child, parent_path, dest_uuid)
+
     def disable_leaf_on_secondary(self, vdi_uuid, secondary=None):
         vdi_ref = self.session.xenapi.VDI.get_by_uuid(vdi_uuid)
         self.session.xenapi.VDI.remove_from_other_config(
