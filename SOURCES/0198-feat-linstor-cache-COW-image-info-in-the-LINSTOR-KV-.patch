         return self._call_method(self._cowutil.repair, 'repair', path, use_parent=False)
 
     @linstormodifier()
@@ -470,6 +520,91 @@ class LinstorCowUtil:
     # Helpers.
     # --------------------------------------------------------------------------
 
+    def _get_cached_volume_image_info(self, vdi_uuid, include_parent, cached_info):
+        # Same check as `complete_only`, done here because `get_info` keeps the
+        # partial fields to compare them with the image on a miss.
+        if set(cached_info) != LinstorVolumeManager.IMAGE_INFO_FIELDS:
+            return None
+
+        image_info = CowImageInfo(vdi_uuid)
+        image_info.sizeVirt = cached_info['size_virt']
+        image_info.hidden = cached_info['hidden']
+
+        parent_uuid = cached_info['parent_uuid']
+        try:
+            image_info.path = self._linstor.build_device_path(
+                self._linstor.get_volume_name(vdi_uuid)
+            )
+            # Building the parentPath using `LinstorVolumeManager`
+            # also checks that the parent in the cache exists.
+            if include_parent and parent_uuid:
+                image_info.parentPath = self._linstor.build_device_path(
+                    self._linstor.get_volume_name(parent_uuid)
+                )
+                image_info.parentUuid = parent_uuid
+        except LinstorVolumeManagerError as e:
+            util.SMlog(f'Error reading info about the parent of {vdi_uuid}, ignoring cached info: {e}')
+            return None
+
+        return image_info
+
+    @staticmethod
+    def _log_stale_cached_fields(vdi_uuid, cached_fields, image_info, include_parent):
+        if image_info.error:
+            return
+        image_fields = {
+            'hidden': image_info.hidden,
+            'size_virt': image_info.sizeVirt
+        }
+        if include_parent:
+            image_fields['parent_uuid'] = image_info.parentUuid or ''
+        for field, image_value in image_fields.items():
+            if field in cached_fields and cached_fields[field] != image_value:
+                util.SMlog(
+                    f'Stale image info of {vdi_uuid} in the KV store: {field} is '
+                    f'{cached_fields[field]!r} in the cache, {image_value!r} in the image'
+                )
+
+    def _store_volume_image_info_in_cache(self, vdi_uuid, image_info):
+        try:
+            self._linstor.set_volume_image_info(
+                vdi_uuid,
+                hidden=image_info.hidden,
+                size_virt=image_info.sizeVirt,
+                parent_uuid=image_info.parentUuid or ''
+            )
+        except Exception as e:
+            util.SMlog(f'Failed to store image info of {vdi_uuid} in KV store: {e}')
+
+    @contextlib.contextmanager
+    def _updating_volume_image_info(self, path, **values):
+        """
+        Keep the image info cached in the KV store in sync with an image
+        modification: the fields of `values` are invalidated before and
+        written after, only if the modification succeeded. A None value is
+        not written (unknown, the next scan reads it). `values` is yielded:
+        the caller can change its values, not its fields, once the
+        modification is done.
+        A crash in between leaves invalid entries, so the next `get_info`
+        reads the image.
+        """
+
+        # We make a dict of fields from `LinstorVolumeManager.IMAGE_INFO_FIELDS` existing or not in `**values`
+        field_exists = dict()
+        for field in LinstorVolumeManager.IMAGE_INFO_FIELDS:
+            field_exists[field] = field in values
+
+        vdi_uuid = self._extract_uuid(path)
+        self._linstor.invalidate_volume_image_info(vdi_uuid, **field_exists)
+
+        yield values
+
+        try:
+            self._linstor.set_volume_image_info(vdi_uuid, **values)
+        except Exception as e:
+            # Not fatal: entries are still invalid.
+            util.SMlog(f'Failed to update image info of {vdi_uuid} in KV store: {e}')
+
     def compute_volume_size(self, virtual_size: int) -> int:
         volume_size = virtual_size
         if VdiType.isCowImage(self._vdi_type):
diff --git a/drivers/linstorvolumemanager.py b/drivers/linstorvolumemanager.py
index 0ddef9b2..f44c42cb 100755
--- a/drivers/linstorvolumemanager.py
+++ b/drivers/linstorvolumemanager.py
@@ -303,6 +303,26 @@ class LinstorVolumeManager(object):
     # Used when volume uuid is being updated.
     PROP_UPDATING_UUID_SRC = 'updating-uuid-src'
 
+    # Properties in KV store of COW image info cached
+    # from the image itself to avoid reading it.
+    # See: get_volume_image_info.
+    PROP_HIDDEN = 'hidden'
+    PROP_SIZE_VIRT = 'size-virt'
+    PROP_PARENT_UUID = 'parent-uuid'
+
+    IMAGE_INFO_PROPS = (PROP_HIDDEN, PROP_SIZE_VIRT, PROP_PARENT_UUID)
+
+    # Image info fields, as given to `set_volume_image_info` and
+    # `invalidate_volume_image_info`.
+    IMAGE_INFO_FIELDS = frozenset(('hidden', 'size_virt', 'parent_uuid'))
+
+    # Written before modifying an image. Any other value than a valid one
+    # means the image must be read again.
+    # Note: A key can't be reliably deleted because the KV object is a
+    # snapshot: a key written by another process after its creation is
+    # unknown locally and the deletion is not forwarded to LINSTOR.
+    IMAGE_INFO_INVALID = 'invalid'
+
     # States of property PROP_NOT_EXISTS.
     STATE_EXISTS = '0'
     STATE_NOT_EXISTS = '1'
@@ -1065,9 +1085,13 @@ class LinstorVolumeManager(object):
                 .format(volume_uuid)
             )
 
-        # 1. Copy in temp variables metadata and volume_name.
+        # 1. Copy in temp variables metadata, volume_name and image info.
         metadata = volume_properties.get(self.PROP_METADATA)
         volume_name = volume_properties.get(self.PROP_VOLUME_NAME)
+        image_info = {
+            prop: volume_properties.get(prop)
+            for prop in self.IMAGE_INFO_PROPS
+        }
 
         # 2. Switch to new volume namespace.
         volume_properties.namespace = self._build_volume_namespace(
@@ -1096,6 +1120,14 @@ class LinstorVolumeManager(object):
                 volume_properties[self.PROP_METADATA] = metadata
             volume_properties[self.PROP_VOLUME_NAME] = volume_name
 
+            # The image info describes the volume content, it follows it.
+            # Always write it: keys unknown by our KV snapshot are not
+            # removed by `clear`, so the new namespace may contain stale ones.
+            for prop, value in image_info.items():
+                if value is None:
+                    value = self.IMAGE_INFO_INVALID
