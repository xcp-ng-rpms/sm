From 63bd8b31fefcac84cde151dea44516123e5a11c3 Mon Sep 17 00:00:00 2001
From: Damien Thenot <damien.thenot@vates.tech>
Date: Mon, 9 Nov 2026 15:51:09 +0100
Subject: [PATCH] feat(linstor): set a max_workers for linstor scan (#185)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The default config for python 3.6 is `nproc*5` which is reducing performance.
Setting max_workers to 4 decrease scan time.
On a test host with ~950 VDIs on a linstor SR, we observed a scan time:
```
real    1m8.591s
user    0m0.000s
sys     0m0.019s
```

To this with `max_workers=4`:
```
real    0m44.522s
user    0m0.014s
sys     0m0.010s
```

Signed-off-by: Damien Thenot <damien.thenot@vates.tech>
---
 drivers/linstorcowutil.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/linstorcowutil.py b/drivers/linstorcowutil.py
index d5006efb..e2872a4d 100644
--- a/drivers/linstorcowutil.py
+++ b/drivers/linstorcowutil.py
@@ -36,6 +36,7 @@ from vditype import VdiType
 
 MANAGER_PLUGIN = 'linstor-manager'
 
+MULTI_MAX_WORKERS = 4
 
 def call_remote_method(session, host_ref, method, args):
     try:
@@ -674,7 +675,7 @@ class MultiLinstorCowUtil:
                 self._init_executor_thread()
             return func(user_data, self)
 
-        with ThreadPoolExecutor(thread_name_prefix="CowUtil") as executor:
+        with ThreadPoolExecutor(max_workers=MULTI_MAX_WORKERS, thread_name_prefix="CowUtil") as executor:
             return executor.map(lambda user_data: wrapper(func, user_data), user_data_list)
 
     def get_local_cowutil(self, vdi_type):
