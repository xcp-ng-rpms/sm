From: Goulven Riou <goulven.riou@vates.tech>
Date: Wed, 4 Nov 2026 16:46:28 +0100
Subject: [PATCH] fix(lvmsr): keep CBT chain usable after vdi_revert

Signed-off-by: Goulven Riou <goulven.riou@vates.tech>
Signed-off-by: Antoine Bartuccio <antoine.bartuccio@vates.tech>
---
 drivers/LVMSR.py | 166 ++++++++++++++++++++++++++++++++++-------------
 drivers/VDI.py   |   7 +-
 drivers/util.py  |   4 ++
 3 files changed, 131 insertions(+), 46 deletions(-)

diff --git a/drivers/LVMSR.py b/drivers/LVMSR.py
index 18593098..8ecc564f 100755
--- a/drivers/LVMSR.py
+++ b/drivers/LVMSR.py
@@ -22,12 +22,14 @@ import errno
 import glob
 import os
 import re
+import shutil
 import sys
 import time
 from contextlib import contextmanager
 from xmlrpc.client import DateTime
 
 import blktap2
