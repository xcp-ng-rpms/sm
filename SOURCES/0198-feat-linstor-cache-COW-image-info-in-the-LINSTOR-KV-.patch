+    def _checkCachedParentMatchesImage(self) -> None:
+        """Called before the first write of a coalesce of this VDI onto its
+        parent: check that its parent in the tree, which can come from cached
+        image info, is the parent in its image. Raise an SMException to
+        cancel the coalesce. Nothing to check by default."""
+        pass
+
     def _relinkSkip(self) -> None:
         """Relink children of this VDI to point to the parent of this VDI"""
         abortFlag = IPCFlag(self.sr.uuid)
@@ -1826,6 +1833,26 @@ class LinstorVDI(VDI):
             self.sr._linstor.get_device_path(parent_uuid)
         )
 
+    @override
+    def _checkCachedParentMatchesImage(self) -> None:
+        # The tree can be built from the image info cached in the KV store:
+        # read the parent in the image itself before merging, a wrong parent
+        # would corrupt data. A remote call can return the string 'None' for
+        # no parent.
+        parent_uuid = self.linstorcowutil.get_parent(self.uuid)
+        if not parent_uuid or parent_uuid == 'None':
+            parent_uuid = None
+        expected_uuid = self.parent.uuid if self.parent else None
+        if parent_uuid != expected_uuid:
+            try:
+                self.sr._linstor.invalidate_volume_image_info(self.uuid)
+            except Exception as e:
+                Util.log('Failed to invalidate the image info of {}: {}'.format(self.uuid, e))
+            raise util.SMException(
+                'Parent of {} in its image is {}, expected {}: coalesce cancelled'
+                .format(self.uuid, parent_uuid, expected_uuid)
+            )
+
     @override
     def _relinkSkip(self) -> None:
         abortFlag = IPCFlag(self.sr.uuid)
@@ -1891,14 +1918,15 @@ class LinstorVDI(VDI):
     def _setHidden(self, hidden=True) -> None:
         HIDDEN_TAG = 'hidden'
 
+        self._hidden = None
         if not VdiType.isCowImage(self.vdi_type):
-            self._hidden = None
             self.sr._linstor.update_volume_metadata(self.uuid, {
                 HIDDEN_TAG: hidden
             })
-            self._hidden = hidden
         else:
-            VDI._setHidden(self, hidden)
+            # Use linstorcowutil to keep the KV store image info in sync.
+            self.linstorcowutil.set_hidden(self.path, hidden)
+        self._hidden = hidden
 
     @override
     def _increaseSizeVirt(self, size, atomic=True):
@@ -2554,6 +2582,8 @@ class SR(object):
             # The parent volume may become inactive if the host is rebooted.
             vdi._ensureParentActiveForRelink()
         else:
+            vdi._checkCachedParentMatchesImage()
+
             # JRN_COALESCE is used to check which VDI is being coalesced in
             # order to decide whether to abort the coalesce. We remove the
             # journal as soon as the COW coalesce step is done, because we
@@ -2903,6 +2933,7 @@ class SR(object):
     def _doCoalesceLeaf(self, vdi: VDI, coalesce_on_remote: bool):
         """Actual coalescing of a leaf VDI onto parent. Must be called in an
         offline/atomic context"""
+        vdi._checkCachedParentMatchesImage()
         self.journaler.create(VDI.JRN_LEAF, vdi.uuid, vdi.parent.uuid)
         self._prepareCoalesceLeaf(vdi)
         vdi.parent._setHidden(False)
@@ -3786,7 +3817,7 @@ class LinstorSR(SR):
         def load_info(vdi, multi_cowutil):
             vdi_uuid, vdi_type = vdi
             try:
-                vdiInfo = multi_cowutil.get_local_cowutil(vdi_type).get_info(vdi_uuid)
+                vdiInfo = multi_cowutil.get_local_cowutil(vdi_type).get_info(vdi_uuid, store_info=True)
             except Exception as e:
                 vdiInfo = handle_fail(vdi_uuid, e)
             vdiInfo.vdiType = vdi_type
@@ -3854,6 +3885,14 @@ class LinstorSR(SR):
 
     def _undoInterruptedCoalesceLeaf(self, childUuid, parentUuid):
         Util.log('*** UNDO LEAF-COALESCE')
+        # The renames below carry the cached image info. Since the
+        # interruption, a scan can have stored the parent of the old leaf
+        # under the uuid the leaf gets back here: the leaf would be its own
+        # parent. Invalidate both volumes, the next scan reads the images.
+        for uuid in (parentUuid, childUuid, self.TMP_RENAME_PREFIX + childUuid):
+            if self.getVDI(uuid):
+                self._linstor.invalidate_volume_image_info(uuid)
+
         parent = self.getVDI(parentUuid)
         if not parent:
             parent = self.getVDI(childUuid)
