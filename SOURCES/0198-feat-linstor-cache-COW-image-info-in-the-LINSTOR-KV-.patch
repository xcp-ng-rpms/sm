+    def get_info(self, vdi_uuid, include_parent=True, store_info=False):
+        # On a hit on the cache, the info comes from the KV store: `sizePhys` and
+        # `sizeAllocated` aren't cached and stay `-1`.
+        # On a miss, the image is read, and with `store_info` the result is written to the KV store for later.
+        # For now, only the master during scan is setting `store_info` to `True`.
+        # Other writers on an image will use `_updating_volume_image_info` to update the info in the cache.
+        # Some callers will use `invalidate_volume_image_info` to invalidate the image cache.
+        # With `include_parent=False`, we can't cache the value of `parent_uuid` and the cache won't be updated.
+        cached_fields = self._linstor.get_volume_image_info(vdi_uuid)
+        image_info = self._get_cached_volume_image_info(vdi_uuid, include_parent, cached_fields)
+        if image_info:
+            return image_info
+
         kwargs = {
             'includeParent': include_parent,
             'resolveParent': False
         }
 
         try:
-            return self._get_info(vdi_uuid, self._extract_uuid, **kwargs)
+            image_info = self._get_info(vdi_uuid, self._extract_uuid, **kwargs)
