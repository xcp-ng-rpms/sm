+        get_info.assert_not_called()
+        self.assertEqual(info.uuid, VDI_UUID)
+        self.assertEqual(info.path, self.path)
+        self.assertEqual(info.sizeVirt, 1024)
+        self.assertEqual(info.sizePhys, -1)
+        self.assertEqual(info.sizeAllocated, -1)
+        self.assertTrue(info.hidden)
+        self.assertEqual(info.parentUuid, PARENT_UUID)
+        self.assertEqual(info.parentPath, self.parent_path)
