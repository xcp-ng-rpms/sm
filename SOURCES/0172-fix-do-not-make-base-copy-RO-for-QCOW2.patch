From a798abc3af149df2731a060be03a0dc3f9facd6f Mon Sep 17 00:00:00 2001
From: Damien Thenot <damien.thenot@vates.tech>
Date: Thu, 3 Sep 2026 17:24:31 +0200
Subject: [PATCH] fix: do not make base copy RO for QCOW2

If we make the base copy RO, the next live coalesce could fail on the call to
tapdisk commit since the chain is only made RW at the activation.

Signed-off-by: Damien Thenot <damien.thenot@vates.tech>
---
 drivers/LVMSR.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/LVMSR.py b/drivers/LVMSR.py
index fc72defc..84eacf7a 100755
--- a/drivers/LVMSR.py
+++ b/drivers/LVMSR.py
@@ -1864,8 +1864,9 @@ class LVMVDI(VDI.VDI):
             util.fistpoint.activate("LVHDRT_clone_vdi_after_parent_hidden", self.sr.uuid)
 
             # set the base copy to ReadOnly
-            self.sr.lvmCache.setReadonly(self.lvname, True)
-            util.fistpoint.activate("LVHDRT_clone_vdi_after_parent_ro", self.sr.uuid)
+            if not self.cowutil.isCoalesceableOnRemote():
+                self.sr.lvmCache.setReadonly(self.lvname, True)
+                util.fistpoint.activate("LVHDRT_clone_vdi_after_parent_ro", self.sr.uuid)
 
             if hostRefs:
                 self.sr._updateSlavesOnClone(hostRefs, origOldLV,
