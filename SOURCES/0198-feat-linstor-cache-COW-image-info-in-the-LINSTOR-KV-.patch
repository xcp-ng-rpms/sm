+
+class FakeKV(dict):
+    """
+    Minimal in-memory replacement of linstor.KV: keys are stored with the
+    namespace prefix, like the real implementation.
+    """
+
+    def __init__(self):
+        super().__init__()
+        self._ns = '/'
+
+    def _set_namespace(self, ns):
+        ns = ns.strip('/')
+        self._ns = '/{}/'.format(ns) if ns else '/'
+
+    # Write-only: the tested code never reads it.
+    namespace = property(fset=_set_namespace)
+
+    def get(self, k, d=None):
+        return super().get(self._ns + k, d)
+
+    def __setitem__(self, k, v):
+        assert isinstance(v, str)
+        super().__setitem__(self._ns + k, v)
+
+    def items(self):
+        for k, v in list(super().items()):
+            if k.startswith(self._ns):
+                yield k[len(self._ns):], v
+
+    def pop(self, k):
+        return super().pop(self._ns + k)
+
+    def clear(self):
+        for k in [k for k in super().keys() if k.startswith(self._ns)]:
+            super().pop(k)
+
+
+def device_path(volume_uuid):
+    return LinstorVolumeManager.build_device_path(
+        LinstorVolumeManager.PREFIX_VOLUME + volume_uuid
+    )
+
+
+def make_manager(volume_uuids):
+    manager = object.__new__(LinstorVolumeManager)
+    manager._kv_cache = FakeKV()
+    manager._kv_cache_dirty = False
+    manager._volumes = set()
+    manager._logger = mock.Mock()
+
+    for volume_uuid in volume_uuids:
+        properties = manager._get_volume_properties(volume_uuid)
+        properties[LinstorVolumeManager.PROP_NOT_EXISTS] = LinstorVolumeManager.STATE_EXISTS
+        properties[LinstorVolumeManager.PROP_VOLUME_NAME] = LinstorVolumeManager.PREFIX_VOLUME + volume_uuid
+        manager._volumes.add(volume_uuid)
+
+    return manager
+
+
+def get_prop(manager, volume_uuid, prop):
+    return manager._get_volume_properties(volume_uuid).get(prop)
+
+
