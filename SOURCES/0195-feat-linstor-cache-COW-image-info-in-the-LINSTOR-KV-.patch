+    def get_volume_image_info(self, volume_uuid):
+        """
+        Get the COW image info cached in the KV store.
+        :param str volume_uuid: The volume to read.
+        :return: A dict with `hidden` (bool), `size_virt` (int) and
+        `parent_uuid` (str, empty if no parent), or None if one of them is
+        missing or invalid.
+        :rtype: dict or None
+        """
+
+        volume_properties = self._get_volume_properties(volume_uuid)
+        hidden = volume_properties.get(self.PROP_HIDDEN)
+        size_virt = volume_properties.get(self.PROP_SIZE_VIRT)
+        parent_uuid = volume_properties.get(self.PROP_PARENT_UUID)
+
+        if hidden not in ('0', '1') or not size_virt or not size_virt.isdigit():
+            return None
+        if parent_uuid is None or parent_uuid == self.IMAGE_INFO_INVALID:
+            return None
+
+        return {
+            'hidden': hidden == '1',
+            'size_virt': int(size_virt),
+            'parent_uuid': parent_uuid
+        }
+
+    def set_volume_image_info(
+        self, volume_uuid, hidden=None, size_virt=None, parent_uuid=None
+    ):
+        """
+        Write COW image info in the KV store. None values are not written.
+        :param str volume_uuid: The volume to modify.
+        :param bool hidden: Hidden flag of the image.
+        :param int size_virt: Virtual size of the image.
+        :param str parent_uuid: Parent uuid of the image, empty if no parent.
+        """
+
+        volume_properties = self._get_volume_properties(volume_uuid)
+        if hidden is not None:
+            volume_properties[self.PROP_HIDDEN] = '1' if hidden else '0'
+        if size_virt is not None:
+            volume_properties[self.PROP_SIZE_VIRT] = str(size_virt)
+        if parent_uuid is not None:
+            volume_properties[self.PROP_PARENT_UUID] = parent_uuid
+
+    def invalidate_volume_image_info(
+        self, volume_uuid, hidden=True, size_virt=True, parent_uuid=True
+    ):
+        """
+        Mark COW image info as invalid in the KV store. Must be called before
+        modifying the image: a crash after this point forces the next read
+        to use the image.
+        :param str volume_uuid: The volume to modify.
+        :param bool hidden: Invalidate the hidden flag.
+        :param bool size_virt: Invalidate the virtual size.
+        :param bool parent_uuid: Invalidate the parent uuid.
+        """
+
+        volume_properties = self._get_volume_properties(volume_uuid)
+        for prop, invalidate in (
+            (self.PROP_HIDDEN, hidden),
+            (self.PROP_SIZE_VIRT, size_virt),
+            (self.PROP_PARENT_UUID, parent_uuid)
+        ):
+            if invalidate:
+                volume_properties[prop] = self.IMAGE_INFO_INVALID
+
