From fcfcd7238f10482a92a8a862060f5e7c1378af49 Mon Sep 17 00:00:00 2001
From: Antoine Bartuccio <antoine.bartuccio@vates.tech>
Date: Tue, 24 Nov 2026 10:36:27 +0100
Subject: [PATCH] fix(lvmsr): Can't determine VDI type with uninitialized xapi
 session

When initializing a VDI, the xapi session might not have been initialized
yet. This happens for example when using `xe host-call-plugin`.
This was introduced when fixing a long time bug where we would get the
wrong vdi_ref when creating a new LVMVDI.

Signed-off-by: Antoine Bartuccio <antoine.bartuccio@vates.tech>
---
 drivers/LVMSR.py | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/LVMSR.py b/drivers/LVMSR.py
index ed605d80..e21e7774 100755
--- a/drivers/LVMSR.py
+++ b/drivers/LVMSR.py
@@ -25,7 +25,7 @@ import re
 import shutil
 import sys
 import time
-from contextlib import contextmanager
+from contextlib import contextmanager, suppress
 from xmlrpc.client import DateTime
 
 import blktap2
@@ -2592,10 +2592,11 @@ class LVMVDI(VDI.VDI):
         Determine whether this is a RAW or a COW VDI.
         """
 
-        try:
-            vdi_ref = self.session.xenapi.VDI.get_by_uuid(self.uuid)
-        except XenAPI.Failure:
-            vdi_ref = None
+        vdi_ref = None
+
+        if self.session: # Search for an existing ref if the xapi session is initialized
+            with suppress(XenAPI.Failure):
+                vdi_ref = self.session.xenapi.VDI.get_by_uuid(self.uuid)
 
         if vdi_ref:
             sm_config = self.session.xenapi.VDI.get_sm_config(vdi_ref)
