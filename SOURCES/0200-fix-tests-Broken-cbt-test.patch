From 1bccab0cea3b541672b66d347cb1c1dc1df2be5f Mon Sep 17 00:00:00 2001
From: Antoine Bartuccio <antoine.bartuccio@vates.tech>
Date: Mon, 9 Nov 2026 09:56:29 +0100
Subject: [PATCH] fix(tests): Broken cbt test

`test_list_changed_blocks_vdi_shrink` broke due to behavioral changes
in the cbt logic. Those are expected changes and tests needs to reflect
those.

Co-authored-by: Goulven Riou <goulven.riou@vates.tech>
Signed-off-by: Antoine Bartuccio <antoine.bartuccio@vates.tech>
---
 tests/test_cbt.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tests/test_cbt.py b/tests/test_cbt.py
index b990056a..41a4af1d 100644
--- a/tests/test_cbt.py
+++ b/tests/test_cbt.py
@@ -692,6 +692,7 @@ class TestCBT(unittest.TestCase):
         self._set_initial_state(self.vdi, True)
         target_uuid = "targetUUID"
         self.xenapi.VDI.get_uuid.return_value = target_uuid
+        mock_cbt.get_cbt_child.side_effect = ["snapUUID", target_uuid]
         vdi_size1 = 10485760  # 10MB
         vdi_size2 = 5242880  # 5MB
         mock_cbt.get_cbt_size.side_effect = [vdi_size1, vdi_size2]
