From ff22e42bff4bb660fcb8506491d9e6be507484f1 Mon Sep 17 00:00:00 2001
From: Damien Thenot <damien.thenot@vates.tech>
Date: Thu, 15 Oct 2026 20:11:48 +0000
Subject: [PATCH] perf(linstor): get the SR's VDI uuids in one XAPI call

`_load_vdis_ex` called `VDI.get_uuid` for each VDI of the SR to build
the set of uuids known by XAPI: one XAPI round trip per VDI, about
0.6 s for ~950 VDIs on a warm-cache scan. Get them with a single
`VDI.get_all_records_where` call filtered on the SR.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Damien Thenot <damien.thenot@vates.tech>
---
 drivers/LinstorSR.py | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/LinstorSR.py b/drivers/LinstorSR.py
index d7837322..bad53d2c 100755
--- a/drivers/LinstorSR.py
+++ b/drivers/LinstorSR.py
@@ -1087,9 +1087,11 @@ class LinstorSR(SR.SR):
     def _load_vdis_ex(self):
         # 1. Get existing VDIs in XAPI.
         xenapi = self.session.xenapi
-        xapi_vdi_uuids = set()
-        for vdi in xenapi.SR.get_VDIs(self.sr_ref):
-            xapi_vdi_uuids.add(xenapi.VDI.get_uuid(vdi))
+        xapi_vdi_uuids = {
+            record['uuid'] for record in xenapi.VDI.get_all_records_where(
+                f'field "SR" = "{self.sr_ref}"'
+            ).values()
+        }
 
         # 2. Get volumes info.
         all_volume_info = self._all_volume_info_cache
