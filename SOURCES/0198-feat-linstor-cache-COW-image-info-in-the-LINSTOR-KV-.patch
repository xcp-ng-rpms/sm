+                raise
+            image_info = self._get_vhd_info(vdi_uuid, self._extract_uuid, **kwargs)
+
+        # Diagnostic only, the image values will be returned (and stored with
+        # `store_info`): log every cached field whose value differs from the
+        # image.
+        self._log_stale_cached_fields(vdi_uuid, cached_fields, image_info, include_parent)
+
+        # Without parent, we can't store the complete info.
+        if store_info and include_parent:
+            self._store_volume_image_info_in_cache(vdi_uuid, image_info)
+        return image_info
 
     @linstorhostcall('getInfo')
