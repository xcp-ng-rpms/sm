+            vdi.sr._linstor.invalidate_volume_image_info.assert_not_called()
+
+    def test_parent_in_image_only_cancels(self):
+        with self.assertRaises(util.SMException):
+            self.vdi(PARENT_UUID, None)._checkCachedParentMatchesImage()
+
+
+class TestParentCheckedBeforeAnyWrite(unittest.TestCase):
